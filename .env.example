# ── Required ─────────────────────────────────────────────────────

# Google Gemini free-tier API key (shared by all users for AI drafting).
# Get one at https://aistudio.google.com/apikey (free, no credit card).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Secret used to sign login session cookies. Generate a random one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# Key used to encrypt users' stored email passwords at rest.
# MUST be exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this safe and back it up — if you lose it, saved email accounts can't be decrypted.
APP_ENCRYPTION_KEY=your_64_hex_character_key

# ── Recommended ──────────────────────────────────────────────────

# Public base URL of your deployment (used in password-reset links).
APP_URL=http://localhost:3000
PORT=3000

# Email address that automatically becomes an admin on signup.
# (Otherwise the very first user to sign up becomes the admin.)
ADMIN_EMAIL=you@yourcompany.com

# System / transactional email account — used to SEND password-reset links.
# This is the server's own account, separate from the sending accounts users
# add in the app. Reuses Gmail App Password style credentials.
# (If omitted, password-reset links are logged to the server console instead.)
GMAIL_USER=system.mailer@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
# ...or a custom SMTP system account instead of Gmail:
# SYSTEM_SMTP_HOST=smtp.office365.com
# SYSTEM_SMTP_PORT=587
# SYSTEM_SMTP_SECURE=false
# SYSTEM_SMTP_USER=system@yourcompany.com
# SYSTEM_SMTP_PASS=your-smtp-password

# ── Optional tuning ──────────────────────────────────────────────

# Random delay (ms) between each email send, to avoid spam-flagging.
SEND_DELAY_MIN_MS=20000
SEND_DELAY_MAX_MS=60000

# Per-user daily send cap (stays under Gmail's ~500/day limit).
MAX_EMAILS_PER_DAY=300

# Delay (ms) between AI draft requests, to respect Gemini free-tier rate limits.
DRAFT_DELAY_MS=4500
